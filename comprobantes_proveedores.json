        "jsCode": "let t = $json.candidates[0].content.parts[0].text.trim();\n\n// quitar fences de markdown por si aparecen\nif (t.startsWith(\"```\")) t = t.replace(/^```(json)?/, \"\").replace(/```$/, \"\").trim();\n\nlet obj;\ntry {\n  obj = JSON.parse(t);\n} catch (e) {\n  // fallback: cortar en el primer objeto JSON balanceado\n  let depth = 0, start = t.indexOf('{'), end = -1;\n  for (let i = start; i < t.length; i++) {\n    if (t[i] === '{') depth++;\n    else if (t[i] === '}') { depth--; if (depth === 0) { end = i; break; } }\n  }\n  obj = JSON.parse(t.slice(start, end + 1));\n}\n\nreturn [{ json: obj }];"
